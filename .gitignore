# Public release allowlist: SPIF core, two entry points, and reproducibility tests.
/*
!/.gitignore
!/LICENSE
!/README.md
!/requirements.txt
!/train.py
!/test.py
!/spif/
!/tests/
!/datasets/
!/checkpoints/
!/results/

# Publish only the empty input/output folder skeleton, never local images or weights.
/datasets/**
!/datasets/trainA_BF/
!/datasets/trainA_AF/
!/datasets/trainB/
!/datasets/testA_BF/
!/datasets/testA_AF/
!/datasets/trainA_BF/.gitkeep
!/datasets/trainA_AF/.gitkeep
!/datasets/trainB/.gitkeep
!/datasets/testA_BF/.gitkeep
!/datasets/testA_AF/.gitkeep
/checkpoints/*
!/checkpoints/.gitkeep
/results/*
!/results/.gitkeep

# Local caches, checkpoints, environment files, and editor state.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.pt
*.pth
*.ckpt
*.log
*.tmp
.env
.env.*
.DS_Store
Thumbs.db

# Local source backups and manuscript assets are excluded by the root allowlist.
/.local_backup/
